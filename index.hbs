{{!< default}}

<div class="post-feed">
    {{#foreach posts limit="10"}}
    <article class="post-card {{post_class}}">
        <header class="post-header">
            <h2 class="post-title"><a href="{{url absolute="true"}}">{{#if title}}{{title}}{{else}}Untitled Post{{/if}}</a></h2>
            <div class="post-meta">
                {{#if published_at}}
                    <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="MMMM DD, YYYY"}}</time>
                {{/if}}
                {{#primary_tag}}
                    <span class="post-tags">in <a href="{{url}}">{{name}}</a></span>
                {{/primary_tag}}
            </div>
        </header>
        
        {{#if feature_image}}
        <figure class="post-card-image">
            <img srcset="{{img_url feature_image size="s"}} 300w,
                        {{img_url feature_image size="m"}} 600w,
                        {{img_url feature_image size="l"}} 1000w"
                 sizes="(max-width: 1000px) 400px, 600px"
                 src="{{img_url feature_image size="m"}}"
                 alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                 loading="lazy"
                 decoding="async" />
        </figure>
        {{/if}}
        
        <section class="post-content">
            {{content}}
        </section>
        
        <footer class="post-footer">
            {{> "post-share"}}
        </footer>
        <hr class="post-divider">
    </article>
    {{/foreach}}
</div>

{{!-- Pagination --}}
{{#if pagination}}
<nav class="pagination" role="navigation" aria-label="Pagination">
    {{#if pagination.prev}}
        <a class="newer-posts" href="{{page_url pagination.prev}}" aria-label="Previous page">&larr; Newer Posts</a>
    {{/if}}
    <span class="page-number">Page {{pagination.page}} of {{pagination.pages}}</span>
    {{#if pagination.next}}
        <a class="older-posts" href="{{page_url pagination.next}}" aria-label="Next page">Older Posts &rarr;</a>
    {{/if}}
</nav>
{{/if}}
